{
  "name": "wishlist-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Wishlist Hub - App de Listas de Regalos",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend",
    "test:cleanup": "npm run test:cleanup --prefix backend",
    "test:ratelimit": "npm run test:ratelimit --prefix backend",
    "test:socket": "npm run test:socket --prefix backend",
    "test:priority": "npm run test:priority --prefix backend",
    "test:friends": "npm run test:friends --prefix backend",
    "test:secretsanta": "npm run test:secretsanta --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
