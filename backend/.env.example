# ==========================================
# 1. SERVIDOR Y ENTORNO
# ==========================================
PORT=5000 # Puerto donde escucha el servidor backend Express
NODE_ENV=development # Entorno: 'development' para local / 'production' para despliegue oficial

# ==========================================
# 2. SEGURIDAD Y TOKENS JWT
# ==========================================
JWT_SECRET=supersecretkey123 # Clave secreta para firmar los access tokens JWT
JWT_REFRESH_SECRET=supersecretrefreshkey123 # Clave secreta para firmar los refresh tokens
JWT_EXPIRES_IN=15m # Tiempo de vida del token de acceso (ej: 15m, 1h)
JWT_REFRESH_EXPIRES_IN=7d # Tiempo de vida del token de refresco (ej: 7d, 30d)

# ==========================================
# 3. BASE DE DATOS
# ==========================================
DATABASE_URL="file:./dev.db" # Ruta SQLite en local o URL PostgreSQL en producción

# ==========================================
# 4. CORS Y ACCESO DE CLIENTES
# ==========================================
FRONTEND_URL=http://localhost:5173 # URL base del frontend para permitir peticiones CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000 # Lista de orígenes permitidos separados por comas

# ==========================================
# 5. SERVICIO DE CORREO (BREVO SMTP / NODEMAILER)
# ==========================================
SMTP_HOST=smtp-relay.brevo.com # Servidor relay de Brevo
SMTP_PORT=587 # Puerto SMTP estándar con STARTTLS
SMTP_USER=bc5e40001@smtp-brevo.com # Usuario SMTP asignado por Brevo
SMTP_PASS=tu_clave_smtp_aqui # Clave secreta SMTP de Brevo
EMAIL_FROM=tu_correo_verificado@gmail.com # Correo remitente verificado en Brevo

# ==========================================
# 6. MODO DESARROLLO Y CONTROL LOCAL
# ==========================================
RESET_DB_ON_START=false # true: cada reinicio en local vacía la base de datos y uploads | false: conserva los datos (ignorado en production)
BYPASS_RATE_LIMIT=true # true: desactiva el límite de peticiones en red local/WiFi para pruebas | false: aplica límites estrictos
